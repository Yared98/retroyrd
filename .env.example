# Configurações do Retroyrd

# Porta do servidor
PORT=8080

# Caminho do banco SQLite
DATABASE_URL=data/retro.db

# Dias de retenção dos boards para auto-purge
BOARD_RETENTION_DAYS=60

# Telemetria anônima com Umami (Opcional - deixe vazio para desativar)
# Exemplo:
# UMAMI_SCRIPT_URL=https://analytics.yared.com.br/script.js
# UMAMI_WEBSITE_ID=dbb9f909-80d0-4f01-ba35-03a382084986
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
